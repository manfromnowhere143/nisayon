  "float32_explanation": {
    "observed_published_std_relative_error": {
      "observation.state": 1.2517564901839413e-05,
      "action": 0.0005073437228845657
    },
    "mechanism": "numpy reduces a C-contiguous (N, D) float32 array along axis 0 sequentially per coordinate; over 101,469 rows the sum of squared deviations accumulates float32 rounding of this size, while sums of dyadic or binary values stay exact",
    "demonstration": "a synthetic binary column of the same length and mean gives 3.2e-4 relative std error under the same reduction and 3.8e-8 under a pairwise reduction; the five-episode subset gives at most 5.2e-6",
    "consequence": "the published action gripper std implies E[x^2] > E[x] for values in [0,1], which no population can satisfy; the excess is computation error, not population evidence"
  },
