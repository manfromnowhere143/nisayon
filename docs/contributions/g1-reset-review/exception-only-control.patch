+def reset_policy_memory(policy):
+    """Reset the supported recurrent state or stop before more control steps."""
+    reset = getattr(policy, "reset_memory", None)
+    try:
+        if callable(reset):
+            reset()
+            return
+        hidden = getattr(policy, "hidden_state", None)
+        cell = getattr(policy, "cell_state", None)
+        if not isinstance(hidden, torch.Tensor) or not isinstance(cell, torch.Tensor):
+            raise TypeError("Policy requires reset_memory() or hidden_state and cell_state tensors")
+        with torch.no_grad():
+            hidden.zero_()
+            cell.zero_()
+    except Exception as exc:
+        raise RuntimeError("Walking policy memory reset failed; stopping teleoperation") from exc
+
