  "decisions": [
    {
      "subject": "Existing owner incidents",
      "status": "awaiting_existing_artifacts",
      "decision": "Keep all four requests discoverable; receive source-matched records and a live decision before expansion. Contact is not a qualified incident."
    },
    {
      "subject": "GR00T padding semantics",
      "status": "candidate_not_admitted",
      "decision": "The diagnosis and proposed correction belong to the upstream authors. Structural invariance and released-checkpoint compatibility are different obligations. Do not select a new default from untrained-model controls."
    },
    {
      "subject": "Simulation proxy",
      "status": "published_arithmetic_readback",
      "evidence": "docs/experiments/results/proxy-ranking-readback-001/result.json",
      "decision": "Choose the deployment decision metric explicitly; preserve unavailable dimensions, correlated comparisons and unknown effect size. No repair-selection or robot-performance claim follows."
    },
    {
      "subject": "Architecture",
      "status": "design_clarification_only",
      "decision": "Bind learned training conventions to serving semantics. Treat unchanged-weight serving changes and fine-tuning as distinct interventions; compare full costs and fresh outcomes."
    }
  ],
  "research_scope": [
    {
      "url": "https://arxiv.org/html/2608.11772v1",
      "finding": "DARC uses declared retry/reset semantics and matched-information evaluation on agent tasks. Its coverage result does not by itself optimize ordered cost. Treat this as relevant prior work, not physical-robot evidence."
    },
    {
      "url": "https://arxiv.org/html/2607.04434v1",
      "finding": "RoboDojo describes remote physical evaluation and verification, but its physical and simulated tasks are not one-to-one matched. Shared interfaces alone do not create a transfer calibration."
    },
    {
      "url": "https://developer.nvidia.com/blog/how-to-evaluate-general-purpose-robot-policies-for-real-world-deployment/",
      "finding": "RoboLab already targets scalable task construction, failure analysis and statistical uncertainty. A generic evaluation wrapper is not a demonstrated Nisayon advantage."
    }
  ],
